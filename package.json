{
  "name": "dsh-bili-eyes",
  "version": "0.6.0",
  "description": "DeepSeek Harness 插件：让模型「看」B站视频（分镜图 + 台词 + 热评 + 弹幕热词）、搜视频、顺着线索逛 B站、看收件箱；点赞、评论、收藏、私信、动态、关注默认关闭，可按档位和额度开启并由主人同意。装上就能用：自己下载视频，ffmpeg 可一键下载。DSH 设置里带管理界面。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "video",
    "storyboard",
    "qq-bot"
  ],
  "license": "MIT",
  "author": "QiuYeDx",
  "homepage": "https://github.com/QiuYeDx/dsh-bili-eyes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QiuYeDx/dsh-bili-eyes.git"
  },
  "bugs": {
    "url": "https://github.com/QiuYeDx/dsh-bili-eyes/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./look": "./src/look.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./interact": "./src/interact.js",
    "./tool-list": "./src/tool-list.js",
    "./gate": "./src/gate.js"
  },
  "bin": {
    "dsh-bili-eyes": "bin/cli.mjs"
  },
  "files": [
    "src",
    "bin",
    "docs/门卫协议.md",
    "docs/冲浪与互动-设计.md",
    "locale",
    "assets",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/contract.test.mjs test/settings.test.mjs test/interact.test.mjs test/surf-agent.test.mjs test/auto-surf.test.mjs test/dsh-qq.test.mjs test/asr-config.test.mjs test/engine.test.mjs test/update.test.mjs",
    "login": "node bin/cli.mjs login",
    "status": "node bin/cli.mjs status",
    "preview": "node dev/preview.mjs"
  },
  "dependencies": {
    "dsh-video-storyboard": "0.4.4",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "icon": "./assets/icon.svg"
}
